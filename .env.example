ENABLE_HYBRID_SEARCH=true
BM25_WEIGHT=0.3
DENSE_WEIGHT=0.7

MAX_RETRIEVAL_ATTEMPTS=3
ENABLE_QUERY_DECOMPOSITION=true
CONFIDENCE_THRESHOLD=0.7

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
